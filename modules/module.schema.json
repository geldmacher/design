{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:geldmacher:schemas:design-module",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "source", "license", "capabilities", "contributes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "source": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["first-party", "vendored"] },
        "url": { "type": "string", "format": "uri" },
        "tag": { "type": "string" },
        "commit": { "type": "string" },
        "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "license": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "skill", "specificity", "triggers", "scope", "combinableWith"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "minLength": 1 },
          "specificity": { "type": "integer", "minimum": 0 },
          "fallback": { "type": "boolean" },
          "triggers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "combinableWith": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "contributes": {
      "type": "object",
      "required": ["skills", "agents", "rules", "hooks", "scripts", "mcpServers"],
      "additionalProperties": false,
      "properties": {
        "skills": { "$ref": "#/$defs/paths" },
        "agents": { "$ref": "#/$defs/paths" },
        "rules": { "$ref": "#/$defs/paths" },
        "hooks": { "$ref": "#/$defs/paths" },
        "scripts": { "$ref": "#/$defs/paths" },
        "mcpServers": { "$ref": "#/$defs/paths" }
      }
    }
  },
  "$defs": {
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
