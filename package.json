{
  "name": "geldmacher-design",
  "version": "0.10.1",
  "private": true,
  "description": "Plan, build, review, and refine websites and web apps around your product and visual language.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/geldmacher/design#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/geldmacher/design.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:capabilities": "node scripts/build-capability-index.mjs",
    "build:targets": "node scripts/build-plugin-targets.mjs",
    "check:targets": "node scripts/build-plugin-targets.mjs --check",
    "deploy:prepare": "npm run build:capabilities && npm run build:targets && npm run check:targets && npm run check:english && npm run validate && node --test tests/plugin-targets.test.mjs tests/portable-runtime.test.mjs tests/local-plugin-deploy.test.mjs",
    "deploy:status": "node scripts/local-plugin-deploy.mjs status",
    "deploy:local": "node scripts/local-plugin-deploy.mjs deploy",
    "install:release": "node scripts/install-release-from-repo.mjs",
    "check:english": "node scripts/check-english.mjs",
    "check:impeccable-upstream": "node scripts/check-impeccable-upstream.mjs",
    "sync:impeccable": "node scripts/sync-impeccable.mjs",
    "prepare:impeccable-update": "node scripts/prepare-impeccable-update.mjs",
    "apply:impeccable-update": "node scripts/apply-impeccable-update.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "release:plugin": "node scripts/plugin-github-release.mjs",
    "release-check": "npm run build:capabilities -- --check && npm run check:targets && npm run check:english && npm run validate && npm test && npm run check:links && npm run verify:impeccable-engine",
    "verify:impeccable-engine": "node .agents/skills/verify-impeccable-engine/scripts/verify.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  }
}
