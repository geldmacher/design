{
  "name": "geldmacher-design",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace-ready Cursor wrapper for curated web design workflows powered by Impeccable.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/geldmacher/geldmacher-design#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/geldmacher/geldmacher-design.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:capabilities": "node scripts/build-capability-index.mjs",
    "sync:impeccable": "node scripts/sync-impeccable.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "release-check": "npm run build:capabilities -- --check && npm run validate && npm test && npm run check:links"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
